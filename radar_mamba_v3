, x):\n\n        # x: [B, 29]\n\n        x = x.unsqueeze(-1)\n\n        # [B,29,1]\n\n        x = self.input_embedding(x)\n\n        # [B,29,d_model]\n\n        x = x + self.antenna_embedding\n\n        for block in self.blocks:\n            x = block(x)\n\n        x = self.final_norm(x)\n\n        # pool over antenna sequence\n        x_mean = x.mean(dim=1)\n\n        x_max = x.max(dim=1).values\n\n        x = 0.5 * (x_mean + x_max)\n\n        x = self.feature_head(x)\n\n        angle_logits = self.angle_head(x)\n\n        count_logits = self.count_head(x)\n\n        return angle_logits, count_logits","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-31T09:44:37.315421Z","iopub.execute_input":"2026-08-31T09:44:37.315844Z","iopub.status.idle":"2026-08-31T09:44:37.32473Z","shell.execute_reply.started":"2026-08-31T09:44:37.315816Z","shell.execute_reply":"2026-08-31T09:44:37.323811Z"}},"outputs":[],"execution_count":130},{"cell_type":"code","source":"\n\npositive = y_train_angle.sum(axis=0)\n\nnegative = len(y_train_angle) - positive\n\npos_weight = (\n    negative /\n    np.maximum(positive, 1)\n)\n\npos_weight = np.clip(\n    pos_weight,\n    1.0,\n    20.0\n)\n\npos_weight = torch.tensor(\n    pos_weight,\n    dtype=torch.float32,\n    \n)\n\nprint(pos_weight.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-31T09:45:24.006128Z","iopub.execute_input":"2026-08-31T09:45:24.006563Z","iopub.status.idle":"2026-08-31T09:45:24.034904Z","shell.execute_reply.started":"2026-08-31T09:45:24.006534Z","shell.execute_reply":"2026-08-31T09:45:24.034304Z"}},"outputs":[{"name":"stdout","text":"torch.Size([121])\n","output_type":"stream"}],"execution_count":132},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}